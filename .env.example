# ── Jarvis AI 서버 로컬 환경 예시 ─────────────────────────────
# 모든 값은 pydantic-settings Settings 필드와 1:1 대응한다 (config 주입 원칙).
# 실사용 시 이 파일을 .env 로 복사해 값을 채운다.

# ── LLM provider 토글 (이슈 #40) ──
# 호출부는 tier(fast/smart)로 부르고 provider 가 모델을 해석한다.
# openai(기본) | anthropic | scripted(local/test 부하 테스트 전용).
# 이 파일(.env)·OS 환경변수가 config.py 기본값보다 우선한다.
LLM_PROVIDER=openai
# scripted 전용: instant=지연 없는 내부 처리량 상한, delayed=요청당 한 번 비동기 지연.
# delayed 기본 5초는 사용자 첫 응답 실측 평균을 보수적으로 반올림한 **추가 대기값**이다.
# 실제 종단 시간에는 이 값 외에 FastAPI·DB·Spring 처리시간도 포함된다.
SCRIPTED_LLM_MODE=instant
SCRIPTED_LLM_DELAY_S=5.0

# ── Anthropic 2-tier LLM (fast=haiku / smart=sonnet) ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
HAIKU_MODEL_ID=claude-haiku-4-5
SONNET_MODEL_ID=claude-sonnet-5

# ── OpenAI 2-tier LLM (fast=nano / smart=luna, 이슈 #40) — 기본 provider ──
# OPENAI_API_KEY 를 채우면 동작. anthropic 으로 되돌리려면 LLM_PROVIDER=anthropic.
# ⚠️ 정확한 API 모델 문자열은 OpenAI 대시보드에서 확인해 넣을 것.
OPENAI_API_KEY=
OPENAI_FAST_MODEL_ID=gpt-5-nano
OPENAI_SMART_MODEL_ID=gpt-5.6-luna
# GPT-5 nano는 none을 지원하지 않으므로 최저 지원값 minimal 사용.
OPENAI_FAST_REASONING_EFFORT=minimal
OPENAI_SMART_REASONING_EFFORT=medium
# 이슈 #178 — 아래 모델(접두사 매칭)은 /v1/chat/completions 에서 function tools 와
# reasoning_effort 를 함께 못 받는다. tool 을 싣는 호출(판매자 레인)에서만 effort 를
# override 값으로 강등한다. 조합을 지원하는 모델로 갈아타면 목록을 비워 원복한다.
OPENAI_TOOL_REASONING_INCOMPATIBLE_MODELS=["gpt-5.6-luna"]
OPENAI_TOOL_REASONING_EFFORT_OVERRIDE=none
# 요청 단위 비용 관측 단가(USD / 1,000 tokens, chat_request 로그 costUsd, 이슈 #437).
# JSON 오브젝트 문자열(모델ID → 단가). 미설정이면 app/core/model_pricing.py 의 코드 기본표
# (gpt-5-nano/gpt-5.6-luna, evals/model_eval/pricing_manifest.json 과 동일 소스)를 쓴다.
# 주입하면 표 전체를 치환한다(기본표와 병합하지 않는다).
MODEL_PRICE_IN_PER_1K=
MODEL_PRICE_OUT_PER_1K=
# 구매자 rerank 근거 표시 production arm. validated(C)가 기본이며 장애 시 current(A)로 즉시 롤백.
# 평가 CLI의 --arms 기본값은 비교 기준 보존을 위해 이 값과 무관하게 current다.
RERANK_GROUNDING_ARM=validated
# 구매자 rerank 순위 계산 arm. blind 평가 결과에 따라 current를 유지하며 나머지는 실험 opt-in.
RERANK_RANKING_ARM=current
# hybrid의 검색순위 비중과 RRF 완화 상수. 범위 밖 값은 애플리케이션 기동 시 거부한다.
RERANK_RRF_ALPHA=0.65
RERANK_RRF_K=60
# structured/hybrid에서 JSON 생성 전에 쓰이는 reasoning token 예비분(current에는 미적용).
RERANK_SCORING_REASONING_TOKEN_RESERVE=4096

# ── LangSmith tracing (선택) ──
# 기본은 비활성화. trace를 전송할 환경에서 true로 설정한다.
# API key는 LangSmith에서 발급하고, 프로젝트명은 환경별로 구분한다
# (예: jarvis-ai-local / jarvis-ai-staging / jarvis-ai-production).
# Docker Compose는 env_file로 읽는다. 직접 uv 실행 시 `uv run --env-file .env ...`를 사용한다.
APP_ENVIRONMENT=local
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jarvis-ai-local
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_EXPORT_TIMEOUT_S=0.5
# [#326] 콘텐츠 추적 모드 — true 면 발화·LLM prompt/응답 원문·Spring 페이로드가 트레이스에 실린다.
# 실사용자 오픈 전 디버깅 전용(기본 off). 규약은 DEPLOY.md §8. 켤 때는 EXPORT_TIMEOUT_S 상향 권장(3.0).
LANGSMITH_TRACE_CONTENT=false
LANGSMITH_TRACE_CONTENT_MAX_CHARS=20000

# ── Google 임베딩 API (MVP, api-spec §4.8 v0.15.14 — 셀프호스트 torch 폐기) ──
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIM=1536
# 주기 증분 pull 배치 스케줄러 간격(초)
CATALOG_BATCH_INTERVAL_S=300

# ── PostgreSQL ×2 ──
# docker-compose 기준: catalog=5433, profile=5434 (호스트 포트)
# catalog: MVP 에서 order_seed 호스트, profile: 프로필 스토어.
CATALOG_DB_URL=postgresql://jarvis:jarvis@localhost:5433/catalog
PROFILE_DB_URL=postgresql://jarvis:jarvis@localhost:5434/profile
# pg-profile application/server/socket timeout + pool/cache 하드닝(이슈 #50)
STATE_STORE_CONNECT_TIMEOUT_S=5
STATE_STORE_QUERY_TIMEOUT_S=3
STATE_STORE_MIGRATION_TIMEOUT_S=30
# psycopg_pool close 자체 기본값과 맞춰 정상 worker 종료를 바깥에서 더 일찍 자르지 않는다.
LIFESPAN_RESOURCE_CLOSE_TIMEOUT_S=5
# 앞의 느린 자원이 cap을 써도 남은 각 자원에 예약할 최소 시도 시간.
LIFESPAN_RESOURCE_CLOSE_FLOOR_S=0.2
# 전체 lifespan cleanup 예산은 배포의 SIGTERM→SIGKILL 유예보다 작게 둔다.
# 현재 deploy.yml의 docker stop은 --time 없이 Docker 기본 유예 10초에 의존한다.
# cap·floor·자원 수와 함께 조정하며, 관계가 어긋나면 기동 실패 대신 cleanup 경고가 남는다.
LIFESPAN_CLEANUP_BUDGET_S=8
STATE_STORE_KEEPALIVES_IDLE_S=10
STATE_STORE_KEEPALIVES_INTERVAL_S=3
STATE_STORE_KEEPALIVES_COUNT=3
STATE_STORE_TCP_USER_TIMEOUT_MS=3000
STATE_STORE_POOL_MIN_SIZE=1
STATE_STORE_POOL_MAX_SIZE=10
STATE_STORE_LOCAL_CACHE_MAX_ENTRIES=10000
SESSION_END_CLAIM_TTL_S=180

# ── Spring 연동 (역방향 호출: 검색·장바구니, api-spec §4) ──
SPRING_BASE_URL=http://localhost:8080
# I-1 검색 재시도 횟수(#133) — 타임아웃·연결 오류·응답 중단·5xx·일시 4xx(408·429) 만 재시도, 그 밖의 4xx·파싱 실패는 즉시 실패.
# SPRING_SEARCH_TIMEOUT_S × (이 값 + 1) 이 STREAM_TOTAL_TIMEOUT_BUYER_S 미만이어야 기동한다.
# STREAM_FIRST_TOKEN_TIMEOUT_S 와의 비교는 PROGRESS_EVENTS_ENABLED=false 일 때만 적용된다
# (기본 true 인 오늘은 첫 SSE 가 conditions 가 아니라 progress 라 first-token 관문 밖에서
# 돈다, #427/DESIGN-SHARED-BUDGET-384 §1(a)).
# [#306] 미룬 턴(#113)도 이제 같은 재시도를 쓴다 — 턴 유형으로 갈리던 억제(#277)를 걷어냈다.
# 첫 conditions 앞 직렬 합은 균질하게
#   3 × SPRING_SEARCH_TIMEOUT_S × (이 값 + 1)
# 이며(본 검색 1 + F-1/#343 구제 폴백 1 + 자동완화 probe 1), 이 값은 STREAM_TOTAL_TIMEOUT_BUYER_S
# 미만이어야 하고(항상), RESCUE_BUDGET_MODE=observe 면 추가로
# STREAM_TOTAL_TIMEOUT_BUYER_S - RESCUE_TAIL_RESERVE_S 미만이어야 한다(narrow/narrow_skip 은
# 런타임 좁히기가 그 예약을 실제로 집행하므로 이 비교를 건너뛴다). 계수를 줄이는 손잡이:
# RELAXATION_MAX_ROUNDS=0 / RELAXATION_AUTO_FIELDS=[] (자동완화 한 단을 뺀다, 계수 3 → 2) 또는
# CATEGORY_EXPAND_ENABLED=false (구제 폴백 한 단을 뺀다, 계수 3 → 2).
# 코드 기본값은 1(#394 를 #406 이 원복했다). 기본 조합의 직렬 합은 3×3.0×2 = 18.0 이고,
# RESCUE_BUDGET_MODE=narrow(기본)라 30.0 만 보면 되므로 기동한다. **되돌릴 때는 짝을 맞춘다** —
# RESCUE_BUDGET_MODE=observe 또는 PROGRESS_EVENTS_ENABLED=false 로 롤백하려면 반드시
# SPRING_MAX_RETRIES=0 을 함께 지정한다(18.0 ≥ 15.0 / 18.0 ≥ 10.0 으로 기동이 거절된다).
SPRING_MAX_RETRIES=1
# [#427] I-1 검색 전용 타임아웃 — AI→Spring 전 구간 공용(SPRING_TIMEOUT_S)과 분리했다.
# 기본값은 api-spec §2.9(c) "AI→Spring 전 구간 3s 통일"과 같은 3.0이다. **상향은 계약
# 개정(§2.9(c)) 선행이 필요하다** — 명세 없이 이 값만 올리면 와이어 계약과 실제 동작이
# 어긋난다. 소비처는 spring_client.py::search_products 뿐이다.
SPRING_SEARCH_TIMEOUT_S=3.0
# [#427] 구제 체인(F-1/#343/자동완화 probe) 예산 집행 강도 — observe: 판정만 계산·로그(반사실),
# 실제 집행 없음. narrow(기본): 잔여 예산이 모자란 단의 타임아웃을 좁혀 시도한다(건너뛰지
# 않는다). narrow_skip: narrow 로도 부족한 단은 건너뛴다(본검색 제외).
# #406 이 #394(SPRING_MAX_RETRIES) 를 원복하며 이 값을 narrow 로 함께 올렸다(§4 결론).
# [#306] observe 로 되돌리려면 SPRING_MAX_RETRIES=0 을 함께 지정해야 한다 — 억제 제거로
# 직렬 합이 18.0 이 되어 observe 의 꼬리 예약 비교(30.0-15.0=15.0)를 넘기 때문이다.
RESCUE_BUDGET_MODE=narrow
# 구제 체인 한 단에 줄 수 있는 최소 타임아웃 — 미만이면 narrow_skip 모드에서 그 단을
# 건너뛴다(본검색 제외). 실측(#385) 전 잠정값.
RESCUE_STAGE_MIN_TIMEOUT_S=0.5
# 구제 체인 잔여 예산 계산의 데드라인에서 미리 떼어 두는 꼬리(rerank·I-21 push) 몫 —
# rerank 실 p95 미확인(#385 실측 대기)이라 LLM_TIMEOUT_S(30.0)의 절반을 보수적으로 예약한다.
RESCUE_TAIL_RESERVE_S=15.0

# ── CORS (FE 직접 호출, api-spec §2.7 / C-11) ──
# JSON 배열 문자열로 주입한다.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── 인증 (api-spec §2.2, RS256 + JWKS 확정 2026-07-15) ──
# dev : 서명 검증 없이 디코드 (헤더 없으면 게스트로 취급) — 로컬 개발 전용
# jwks: Spring GET /.well-known/jwks.json 공개키로 RS256 검증 (kid→키, exp/iss/aud)
AUTH_MODE=dev
JWKS_URL=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER=jarvis-spring-auth
JWT_AUDIENCE=jarvis-fastapi-ai
# 스트림 티켓 scope 확정값. exact chat:stream만 허용하며 빈 값·다른 값은 기동 실패한다.
JWT_SCOPE=chat:stream

# ── AI↔Spring internal 서비스 토큰 (X-Internal-Token, api-spec §2.3) ──
# 양방향 실사용: 아웃바운드 AI→Spring 역호출(I-2 담기·I-19 주문·I-16 카탈로그 등,
# spring_client) + 인바운드 검증(deps.py). backend application-local.yml 의
# app.internal.token 과 반드시 동일 값. auth_mode=dev(로컬 기본)는 빈 값 허용,
# jwks 전환 시 필수(미설정 시 기동 실패).
INTERNAL_API_TOKEN=

# ── 검색/추천 튜너블 (SPEC-RECOMMEND-001) ──
SEARCH_DEFAULT_LIMIT=30
TOP_K=30
EXPOSE_MIN=5
EXPOSE_MAX=8
LLM_CALL_LIMIT=2
RELAXATION_MAX_ROUNDS=3
# 자동 완화(사용자 동의 없이 서버가 먼저 조건을 푸는) 허용 목록 (#113).
# **넓힐 수 없다** — priceMax·priceMin·brand·color 를 넣으면 기동에 실패한다
# (REQ-REC-043·AC-REC-08 가격 제약 불가침: 명시 제약은 제안 칩으로만 위임한다).
# 비우면([]) 자동 완화가 전면 off 되고 완화는 제안 칩으로만 나간다.
# **RELAXATION_CHIP_FIELDS 의 부분집합**이어야 한다 — 후보가 칩 목록에서만 만들어지므로,
# 칩 목록에 없는 필드를 여기 두면 자동 완화가 조용히 죽는다(그 조합도 기동 실패로 막는다).
# 나머지 완화 튜너블(폭·칩 probe 상한·소량 임계)은 app/core/config.py 참조.
RELAXATION_AUTO_FIELDS=["ratingMin"]

# ── degrade 고지 문구 (#133) ──
# 사용자에게 그대로 나가는 텍스트. **문안만 바꿀 수 있고 고지를 끌 수는 없다** —
# 아래 둘은 api-spec §3.3 이 발신을 요구하므로 빈 값이면 기동에 실패한다.
RERANK_FALLBACK_NOTICE=추천 이유까지 정리하진 못했어요. 검색 결과 순서로 보여드릴게요.
PUSH_SKIPPED_NOTICE=목록을 준비하는 데 문제가 있었어요. 잠시 후 다시 시도해 주세요.
# 최근 구매 제외(I-19) 실패 안내 — 기본 미고지. 값을 채우면 켜진다.
DEDUP_SKIPPED_NOTICE=

# ── 프로필 (SPEC-PROFILE-001, 내부 전용) ──
PROFILE_SUMMARY_MAX_CHARS=1000
# 저장된 마지막 회원 발화 기준 inactivity 종료(이슈 #79). 탭 닫기 신호는 사용하지 않는다.
PROFILE_SESSION_IDLE_TIMEOUT_S=600
PROFILE_IDLE_SWEEP_INTERVAL_S=60
# 매 sweep 처리 상한·동시 finalizer 수·activity claim lease(초).
PROFILE_IDLE_SWEEP_BATCH_SIZE=10
PROFILE_IDLE_MAX_CONCURRENCY=2
PROFILE_IDLE_CLAIM_TTL_S=900
