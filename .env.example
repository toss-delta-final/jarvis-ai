# ── Jarvis AI 서버 로컬 환경 예시 ─────────────────────────────
# 모든 값은 pydantic-settings Settings 필드와 1:1 대응한다 (config 주입 원칙).
# 실사용 시 이 파일을 .env 로 복사해 값을 채운다.

# ── LLM provider 토글 (이슈 #40) ──
# 호출부는 tier(fast/smart)로 부르고 provider 가 모델을 해석한다. openai(기본) | anthropic.
# 이 파일(.env)·OS 환경변수가 config.py 기본값보다 우선한다.
LLM_PROVIDER=openai

# ── Anthropic 2-tier LLM (fast=haiku / smart=sonnet) ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
HAIKU_MODEL_ID=claude-haiku-4-5
SONNET_MODEL_ID=claude-sonnet-5

# ── OpenAI 2-tier LLM (fast=nano / smart=luna, 이슈 #40) — 기본 provider ──
# OPENAI_API_KEY 를 채우면 동작. anthropic 으로 되돌리려면 LLM_PROVIDER=anthropic.
# ⚠️ 정확한 API 모델 문자열은 OpenAI 대시보드에서 확인해 넣을 것.
OPENAI_API_KEY=
OPENAI_FAST_MODEL_ID=gpt-5-nano
OPENAI_SMART_MODEL_ID=gpt-5.6-luna
# GPT-5 nano는 none을 지원하지 않으므로 최저 지원값 minimal 사용.
OPENAI_FAST_REASONING_EFFORT=minimal
OPENAI_SMART_REASONING_EFFORT=medium
# 이슈 #178 — 아래 모델(접두사 매칭)은 /v1/chat/completions 에서 function tools 와
# reasoning_effort 를 함께 못 받는다. tool 을 싣는 호출(판매자 레인)에서만 effort 를
# override 값으로 강등한다. 조합을 지원하는 모델로 갈아타면 목록을 비워 원복한다.
OPENAI_TOOL_REASONING_INCOMPATIBLE_MODELS=["gpt-5.6-luna"]
OPENAI_TOOL_REASONING_EFFORT_OVERRIDE=none

# ── LangSmith tracing (선택) ──
# 기본은 비활성화. trace를 전송할 환경에서 true로 설정한다.
# API key는 LangSmith에서 발급하고, 프로젝트명은 환경별로 구분한다
# (예: jarvis-ai-local / jarvis-ai-staging / jarvis-ai-production).
# Docker Compose는 env_file로 읽는다. 직접 uv 실행 시 `uv run --env-file .env ...`를 사용한다.
APP_ENVIRONMENT=local
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jarvis-ai-local
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_EXPORT_TIMEOUT_S=0.5

# ── Google 임베딩 API (MVP, api-spec §4.8 v0.15.14 — 셀프호스트 torch 폐기) ──
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIM=1536
# 주기 증분 pull 배치 스케줄러 간격(초)
CATALOG_BATCH_INTERVAL_S=300

# ── PostgreSQL ×2 ──
# docker-compose 기준: catalog=5433, profile=5434 (호스트 포트)
# catalog: MVP 에서 order_seed 호스트, profile: 프로필 스토어.
CATALOG_DB_URL=postgresql://jarvis:jarvis@localhost:5433/catalog
PROFILE_DB_URL=postgresql://jarvis:jarvis@localhost:5434/profile
# pg-profile application/server/socket timeout + pool/cache 하드닝(이슈 #50)
STATE_STORE_CONNECT_TIMEOUT_S=5
STATE_STORE_QUERY_TIMEOUT_S=3
STATE_STORE_MIGRATION_TIMEOUT_S=30
# psycopg_pool close 자체 기본값과 맞춰 정상 worker 종료를 바깥에서 더 일찍 자르지 않는다.
LIFESPAN_RESOURCE_CLOSE_TIMEOUT_S=5
# 앞의 느린 자원이 cap을 써도 남은 각 자원에 예약할 최소 시도 시간.
LIFESPAN_RESOURCE_CLOSE_FLOOR_S=0.2
# 전체 lifespan cleanup 예산은 배포의 SIGTERM→SIGKILL 유예보다 작게 둔다.
# 현재 deploy.yml의 docker stop은 --time 없이 Docker 기본 유예 10초에 의존한다.
# cap·floor·자원 수와 함께 조정하며, 관계가 어긋나면 기동 실패 대신 cleanup 경고가 남는다.
LIFESPAN_CLEANUP_BUDGET_S=8
STATE_STORE_KEEPALIVES_IDLE_S=10
STATE_STORE_KEEPALIVES_INTERVAL_S=3
STATE_STORE_KEEPALIVES_COUNT=3
STATE_STORE_TCP_USER_TIMEOUT_MS=3000
STATE_STORE_POOL_MIN_SIZE=1
STATE_STORE_POOL_MAX_SIZE=10
STATE_STORE_LOCAL_CACHE_MAX_ENTRIES=10000
SESSION_END_CLAIM_TTL_S=180

# ── Spring 연동 (역방향 호출: 검색·장바구니, api-spec §4) ──
SPRING_BASE_URL=http://localhost:8080
# I-1 검색 재시도 횟수(#133) — 타임아웃·연결 오류·응답 중단·5xx 만 재시도, 4xx·파싱 실패는 즉시 실패.
# SPRING_TIMEOUT_S × (이 값 + 1) 이 STREAM_FIRST_TOKEN_TIMEOUT_S 미만이어야 기동한다.
SPRING_MAX_RETRIES=1

# ── CORS (FE 직접 호출, api-spec §2.7 / C-11) ──
# JSON 배열 문자열로 주입한다.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── 인증 (api-spec §2.2, RS256 + JWKS 확정 2026-07-15) ──
# dev : 서명 검증 없이 디코드 (헤더 없으면 게스트로 취급) — 로컬 개발 전용
# jwks: Spring GET /.well-known/jwks.json 공개키로 RS256 검증 (kid→키, exp/iss/aud)
AUTH_MODE=dev
JWKS_URL=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER=jarvis-spring-auth
JWT_AUDIENCE=jarvis-fastapi-ai
# 스트림 티켓 scope 확정값. exact chat:stream만 허용하며 빈 값·다른 값은 기동 실패한다.
JWT_SCOPE=chat:stream

# ── AI↔Spring internal 서비스 토큰 (X-Internal-Token, api-spec §2.3) ──
# 양방향 실사용: 아웃바운드 AI→Spring 역호출(I-2 담기·I-19 주문·I-16 카탈로그 등,
# spring_client) + 인바운드 검증(deps.py). backend application-local.yml 의
# app.internal.token 과 반드시 동일 값. auth_mode=dev(로컬 기본)는 빈 값 허용,
# jwks 전환 시 필수(미설정 시 기동 실패).
INTERNAL_API_TOKEN=

# ── 검색/추천 튜너블 (SPEC-RECOMMEND-001) ──
SEARCH_DEFAULT_LIMIT=30
TOP_K=30
EXPOSE_MIN=5
EXPOSE_MAX=8
LLM_CALL_LIMIT=2
RELAXATION_MAX_ROUNDS=3

# ── degrade 고지 문구 (#133) ──
# 사용자에게 그대로 나가는 텍스트. **문안만 바꿀 수 있고 고지를 끌 수는 없다** —
# 아래 둘은 api-spec §3.3 이 발신을 요구하므로 빈 값이면 기동에 실패한다.
RERANK_FALLBACK_NOTICE=추천 이유까지 정리하진 못했어요. 검색 결과 순서로 보여드릴게요.
PUSH_SKIPPED_NOTICE=목록을 준비하는 데 문제가 있었어요. 잠시 후 다시 시도해 주세요.
# 최근 구매 제외(I-19) 실패 안내 — 기본 미고지. 값을 채우면 켜진다.
DEDUP_SKIPPED_NOTICE=

# ── 프로필 (SPEC-PROFILE-001, 내부 전용) ──
PROFILE_SUMMARY_MAX_CHARS=1000
# 저장된 마지막 회원 발화 기준 inactivity 종료(이슈 #79). 탭 닫기 신호는 사용하지 않는다.
PROFILE_SESSION_IDLE_TIMEOUT_S=600
PROFILE_IDLE_SWEEP_INTERVAL_S=60
# 매 sweep 처리 상한·동시 finalizer 수·activity claim lease(초).
PROFILE_IDLE_SWEEP_BATCH_SIZE=10
PROFILE_IDLE_MAX_CONCURRENCY=2
PROFILE_IDLE_CLAIM_TTL_S=900
